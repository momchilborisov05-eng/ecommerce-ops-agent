# Copy this file to ".env". Every value is optional: with nothing set, the project runs
# in demo mode (scripted LLM) with offline sandbox integrations.

# --- Claude (live mode) --- key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default) or claude-sonnet-5-5 (faster, cheaper)
CLAUDE_MODEL=claude-opus-5-5
# auto (live when ANTHROPIC_API_KEY is set), demo or live
OPS_AGENT_MODE=auto

# --- Slack --- a bot token with chat:write (preferred) or an incoming webhook URL
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# --- ClickUp --- personal API token (Settings > Apps) and the id of the list for new tasks
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=

# --- Gmail --- OAuth access token with the gmail.compose scope, and the From address
GMAIL_ACCESS_TOKEN=
GMAIL_SEND_AS=

# --- Advanced ---
# OPS_AGENT_DB=ops.db
# OPS_STORE_DATE=2026-10-28
